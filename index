<!doctype html>
<html lang="id" class="h-full">
 <head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pembelajaran Tata Surya Kelas 5 SD</title>
  <script src="/_sdk/element_sdk.js"></script>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/lucide@0.263.0/dist/umd/lucide.min.js"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght=500;600;700;800&family=Nunito:wght=400;600;700;800&display=swap');

    html, body {
      height: 100%;
      width: 100%;
      margin: 0;
      overflow: hidden;
    }

    body {
      font-family: "Nunito", sans-serif;
      background: #060b13;
      color: #f1f5f9;
    }

    .font-title {
      font-family: "Baloo 2", sans-serif;
    }

    /* Scrollbar Styling */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: rgba(255,255,255,0.05);
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(255,255,255,0.2);
      border-radius: 3px;
    }

    /* Keyframes for animations */
    @keyframes orbit-rotate {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    @keyframes pulse-glow {
      0%, 100% { opacity: 0.6; transform: scale(1); }
      50% { opacity: 1; transform: scale(1.05); }
    }

    @keyframes float {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-10px); }
    }

    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      25% { transform: translateX(-6px); }
      75% { transform: translateX(6px); }
    }

    .animate-orbit-mercury { animation: orbit-rotate 8s linear infinite; }
    .animate-orbit-venus { animation: orbit-rotate 12s linear infinite; }
    .animate-orbit-earth { animation: orbit-rotate 16s linear infinite; }
    .animate-orbit-mars { animation: orbit-rotate 20s linear infinite; }
    .animate-orbit-jupiter { animation: orbit-rotate 28s linear infinite; }
    .animate-orbit-saturn { animation: orbit-rotate 36s linear infinite; }

    .glow-sun {
      filter: drop-shadow(0 0 20px rgba(234, 179, 8, 0.8));
      animation: pulse-glow 4s ease-in-out infinite;
    }

    .float-astronaut {
      animation: float 6s ease-in-out infinite;
    }

    .animate-shake {
      animation: shake 0.3s ease-in-out;
    }

    .star-bg {
      background-image: 
        radial-gradient(white, rgba(255,255,255,.2) 2px, transparent 40px),
        radial-gradient(white, rgba(255,255,255,.15) 1px, transparent 30px),
        radial-gradient(white, rgba(255,255,255,.1) 2px, transparent 40px);
      background-size: 550px 550px, 350px 350px, 250px 250px;
      background-position: 0 0, 40px 60px, 130px 270px;
    }
  </style>
 </head>
 <body class="h-full star-bg flex flex-col">

  <!-- Header / Navigasi Atas -->
  <header class="bg-slate-950/80 border-b border-slate-800 px-6 py-4 flex items-center justify-between z-20 backdrop-blur-md">
    <div class="flex items-center gap-3">
      <div class="p-2 bg-indigo-600/20 text-indigo-400 rounded-lg border border-indigo-500/30">
        <i data-lucide="orbit" class="w-6 h-6 animate-spin" style="animation-duration: 10s"></i>
      </div>
      <div>
        <h1 class="font-title text-xl md:text-2xl font-bold bg-gradient-to-r from-indigo-400 via-purple-400 to-pink-400 bg-clip-text text-transparent">PETUALANGAN TATA SURYA</h1>
        <p class="text-xs text-slate-400 font-semibold tracking-wider uppercase">Ilmu Pengetahuan Alam - Kelas 5 SD</p>
      </div>
    </div>
    
    <div class="flex items-center gap-4">
      <div id="score-badge" class="bg-slate-800 border border-slate-700 px-3 py-1.5 rounded-full flex items-center gap-2 text-sm font-semibold text-amber-400">
        <i data-lucide="star" class="w-4 h-4 fill-amber-400"></i>
        <span>Skor: <span id="total-score">0</span></span>
      </div>
      <button onclick="toggleAudio()" class="p-2 bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded-lg text-slate-300 transition" id="audio-toggle-btn" title="Aktifkan/Matikan Suara">
        <i data-lucide="volume-2" class="w-5 h-5"></i>
      </button>
    </div>
  </header>

  <!-- Layout Utama -->
  <div class="flex-1 flex overflow-hidden relative">
    
    <!-- Sidebar Menu Navigasi -->
    <nav class="hidden lg:flex flex-col w-64 bg-slate-950/40 border-r border-slate-900 p-4 justify-between">
      <div class="space-y-2">
        <p class="text-xs font-bold text-slate-500 uppercase tracking-widest px-3 mb-4">Daftar Misi</p>
        
        <button onclick="goToSlide(0)" class="menu-btn w-full flex items-center gap-3 px-4 py-3 rounded-xl transition font-medium text-left bg-slate-800 text-indigo-400 border border-indigo-500/20" data-slide="0">
          <i data-lucide="home" class="w-5 h-5"></i>
          <span>Gerbang Misi</span>
        </button>

        <button onclick="goToSlide(1)" class="menu-btn w-full flex items-center gap-3 px-4 py-3 rounded-xl transition font-medium text-left text-slate-400 hover:bg-slate-900" data-slide="1">
          <i data-lucide="compass" class="w-5 h-5"></i>
          <span>Peta Tata Surya</span>
        </button>

        <button onclick="goToSlide(2)" class="menu-btn w-full flex items-center gap-3 px-4 py-3 rounded-xl transition font-medium text-left text-slate-400 hover:bg-slate-900" data-slide="2">
          <i data-lucide="video" class="w-5 h-5"></i>
          <span>Video Belajar</span>
        </button>

        <button onclick="goToSlide(3)" class="menu-btn w-full flex items-center gap-3 px-4 py-3 rounded-xl transition font-medium text-left text-slate-400 hover:bg-slate-900" data-slide="3">
          <i data-lucide="book-open" class="w-5 h-5"></i>
          <span>Kamus Planet</span>
        </button>

        <button onclick="goToSlide(4)" class="menu-btn w-full flex items-center gap-3 px-4 py-3 rounded-xl transition font-medium text-left text-slate-400 hover:bg-slate-900" data-slide="4">
          <i data-lucide="move" class="w-5 h-5"></i>
          <span>Pasangkan Planet</span>
        </button>

        <button onclick="goToSlide(5)" class="menu-btn w-full flex items-center gap-3 px-4 py-3 rounded-xl transition font-medium text-left text-slate-400 hover:bg-slate-900" data-slide="5">
          <i data-lucide="edit-3" class="w-5 h-5"></i>
          <span>Lengkapi Kalimat</span>
        </button>

        <button onclick="goToSlide(6)" class="menu-btn w-full flex items-center gap-3 px-4 py-3 rounded-xl transition font-medium text-left text-slate-400 hover:bg-slate-900" data-slide="6">
          <i data-lucide="award" class="w-5 h-5"></i>
          <span>Kuis Bintang</span>
        </button>
      </div>

      <div class="p-4 bg-indigo-950/20 border border-indigo-900/30 rounded-xl text-center">
        <p class="text-xs text-indigo-400 font-semibold mb-1">Misi Kamu:</p>
        <p id="mission-status-text" class="text-sm font-bold text-slate-200">Selesaikan kuis untuk lulus petualangan!</p>
      </div>
    </nav>

    <!-- Konten Slide / Main Stage -->
    <main class="flex-1 overflow-y-auto p-4 md:p-8 relative">
      
      <!-- Slide 0: Gerbang Misi / Landing Page -->
      <section id="slide-0" class="slide-pane max-w-4xl mx-auto flex flex-col md:flex-row items-center justify-center gap-10 min-h-[70vh]">
        <div class="flex-1 text-center md:text-left space-y-6">
          <div class="inline-flex items-center gap-2 bg-indigo-500/10 border border-indigo-500/30 text-indigo-300 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider">
            <i data-lucide="sparkles" class="w-3.5 h-3.5 animate-pulse"></i> Belajar itu Menyenangkan!
          </div>
          <h2 class="font-title text-4xl md:text-6xl font-black text-white leading-tight">
            Jelajahi Misteri <span class="text-indigo-400">Tata Surya</span> Kita!
          </h2>
          <p class="text-slate-300 text-lg leading-relaxed">
            Halo Kapten Cilik! Selamat datang di wahana simulasi luar angkasa. Bersiaplah meluncur untuk mengenal matahari, planet-planet mengagumkan, dan menyelesaikan misi-misi seru untuk mendapatkan Bintang Angkasa!
          </p>
          <div class="pt-4 flex flex-col sm:flex-row items-center gap-4 justify-center md:justify-start">
            <button onclick="goToSlide(1)" class="w-full sm:w-auto px-8 py-4 bg-indigo-600 hover:bg-indigo-500 font-title text-lg font-bold rounded-2xl shadow-lg shadow-indigo-600/30 transition transform hover:-translate-y-1 flex items-center justify-center gap-2">
              <span>Mulai Petualangan</span>
              <i data-lucide="rocket" class="w-5 h-5"></i>
            </button>
            <button onclick="goToSlide(4)" class="w-full sm:w-auto px-6 py-4 bg-slate-800 hover:bg-slate-700 font-title text-lg font-bold rounded-2xl transition flex items-center justify-center gap-2 border border-slate-700">
              <i data-lucide="gamepad-2" class="w-5 h-5"></i>
              <span>Mainkan Game</span>
            </button>
          </div>
        </div>
        <div class="flex-1 flex justify-center items-center">
          <div class="relative w-72 h-72 md:w-96 md:h-96 flex items-center justify-center">
            <!-- Glowing background -->
            <div class="absolute inset-0 bg-indigo-500/20 rounded-full filter blur-3xl animate-pulse"></div>
            <!-- Astronaut Illustration -->
            <div class="float-astronaut z-10 text-center">
              <span class="text-[120px] md:text-[160px] drop-shadow-2xl">👨‍🚀</span>
              <p class="text-xs text-indigo-300 bg-slate-900/80 border border-indigo-500/20 px-3 py-1 rounded-full inline-block backdrop-blur-sm mt-2">KAPTAIN CHICO</p>
            </div>
            <!-- Tiny Orbiting Planets -->
            <div class="absolute w-full h-full animate-orbit-earth">
              <span class="absolute top-0 left-12 text-3xl">🌍</span>
            </div>
            <div class="absolute w-[80%] h-[80%] animate-orbit-venus">
              <span class="absolute bottom-4 right-10 text-2xl">🪐</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Slide 1: Peta Tata Surya (Interactive Map) -->
      <section id="slide-1" class="slide-pane hidden max-w-5xl mx-auto space-y-6">
        <div class="text-center space-y-2">
          <h2 class="font-title text-3xl font-black text-white">Peta Lintasan Tata Surya</h2>
          <p class="text-slate-400">Klik salah satu objek luar angkasa untuk membuka rahasia menariknya!</p>
        </div>

        <div class="bg-slate-950/60 border border-slate-800 rounded-3xl p-6 relative overflow-hidden flex items-center justify-center min-h-[450px]">
          <!-- Grid space simulator -->
          <div class="absolute inset-0 pointer-events-none opacity-20 bg-[linear-gradient(rgba(255,255,255,0.05)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.05)_1px,transparent_1px)] bg-[size:30px_30px]"></div>

          <!-- Solar System Map Container (Responsive SVG & Absolute Items) -->
          <div class="relative w-full max-w-5xl aspect-[2.2/1] flex items-center justify-center">
            
            <!-- Matahari -->
            <div onclick="selectPlanet('Matahari')" class="absolute left-2 w-16 h-16 md:w-24 md:h-24 bg-yellow-500 rounded-full glow-sun flex items-center justify-center cursor-pointer hover:scale-110 transition duration-300 z-10 border-4 border-yellow-300">
              <span class="font-title text-[10px] md:text-xs font-bold text-slate-900">Matahari</span>
            </div>

            <!-- Orbit Lines (Dotted Lines as Guidelines) -->
            <div class="absolute inset-y-0 left-12 w-[90%] flex flex-col justify-around pointer-events-none opacity-20">
              <div class="border-b border-dashed border-slate-600 w-full"></div>
              <div class="border-b border-dashed border-slate-600 w-full"></div>
            </div>

            <!-- Planet Nodes positioned nicely across the desktop/mobile view -->
            <!-- 1. Merkurius -->
            <div class="absolute left-[16%] top-[45%] flex flex-col items-center">
              <div onclick="selectPlanet('Merkurius')" class="w-7 h-7 rounded-full bg-amber-600 hover:scale-125 transition cursor-pointer border-2 border-amber-400 flex items-center justify-center shadow-lg shadow-amber-600/30"></div>
              <span class="text-[9px] md:text-[10px] mt-1 font-bold text-slate-300">Merkurius</span>
            </div>

            <!-- 2. Venus -->
            <div class="absolute left-[27%] top-[25%] flex flex-col items-center">
              <div onclick="selectPlanet('Venus')" class="w-9 h-9 rounded-full bg-amber-400 hover:scale-125 transition cursor-pointer border-2 border-amber-200 flex items-center justify-center shadow-lg shadow-amber-400/30"></div>
              <span class="text-[9px] md:text-[10px] mt-1 font-bold text-slate-300">Venus</span>
            </div>

            <!-- 3. Bumi -->
            <div class="absolute left-[38%] top-[60%] flex flex-col items-center">
              <div onclick="selectPlanet('Bumi')" class="w-10 h-10 rounded-full bg-blue-500 hover:scale-125 transition cursor-pointer border-2 border-blue-300 flex items-center justify-center shadow-lg shadow-blue-500/30">
                <span class="text-[8px] absolute -top-1 right-0">🌙</span>
              </div>
              <span class="text-[9px] md:text-[10px] mt-1 font-bold text-slate-300">Bumi</span>
            </div>

            <!-- 4. Mars -->
            <div class="absolute left-[49%] top-[30%] flex flex-col items-center">
              <div onclick="selectPlanet('Mars')" class="w-8 h-8 rounded-full bg-red-600 hover:scale-125 transition cursor-pointer border-2 border-red-400 flex items-center justify-center shadow-lg shadow-red-600/30"></div>
              <span class="text-[9px] md:text-[10px] mt-1 font-bold text-slate-300">Mars</span>
            </div>

            <!-- 5. Jupiter -->
            <div class="absolute left-[60%] top-[55%] flex flex-col items-center">
              <div onclick="selectPlanet('Jupiter')" class="w-14 h-14 rounded-full bg-orange-400 hover:scale-125 transition cursor-pointer border-2 border-orange-300 flex items-center justify-center shadow-lg shadow-orange-400/30 overflow-hidden">
                <div class="w-full h-2 bg-orange-600/30 absolute top-1/2"></div>
              </div>
              <span class="text-[9px] md:text-[10px] mt-1 font-bold text-slate-300">Jupiter</span>
            </div>

            <!-- 6. Saturnus -->
            <div class="absolute left-[72%] top-[25%] flex flex-col items-center">
              <div class="relative flex items-center justify-center">
                <div class="w-16 h-5 border border-amber-300/50 rounded-full absolute rotate-[-15deg] pointer-events-none"></div>
                <div onclick="selectPlanet('Saturnus')" class="w-11 h-11 rounded-full bg-yellow-600 hover:scale-125 transition cursor-pointer border-2 border-yellow-400 z-10"></div>
              </div>
              <span class="text-[9px] md:text-[10px] mt-1 font-bold text-slate-300">Saturnus</span>
            </div>

            <!-- 7. Uranus -->
            <div class="absolute left-[83%] top-[65%] flex flex-col items-center">
              <div class="relative flex items-center justify-center">
                <!-- Cincin tipis vertikal khas Uranus -->
                <div class="w-4 h-14 border border-blue-200/40 rounded-full absolute rotate-[80deg] pointer-events-none"></div>
                <div onclick="selectPlanet('Uranus')" class="w-10 h-10 rounded-full bg-sky-400 hover:scale-125 transition cursor-pointer border-2 border-sky-300 z-10 shadow-lg shadow-sky-400/30"></div>
              </div>
              <span class="text-[9px] md:text-[10px] mt-1 font-bold text-slate-300">Uranus</span>
            </div>

            <!-- 8. Neptunus -->
            <div class="absolute left-[94%] top-[35%] flex flex-col items-center">
              <div onclick="selectPlanet('Neptunus')" class="w-10 h-10 rounded-full bg-blue-700 hover:scale-125 transition cursor-pointer border-2 border-blue-500 flex items-center justify-center shadow-lg shadow-blue-800/40"></div>
              <span class="text-[9px] md:text-[10px] mt-1 font-bold text-slate-300">Neptunus</span>
            </div>

          </div>
        </div>

        <!-- Info Card Tampilan Sementara Planet -->
        <div id="quick-info-box" class="bg-indigo-950/40 border border-indigo-500/20 p-5 rounded-2xl flex flex-col md:flex-row gap-5 items-center">
          <div class="text-4xl p-4 bg-indigo-500/10 rounded-full" id="quick-info-emoji">🛰️</div>
          <div>
            <h3 class="font-title text-xl font-bold text-indigo-300" id="quick-info-title">Pilih Planet Diatas!</h3>
            <p class="text-slate-300 text-sm leading-relaxed" id="quick-info-desc">Klik salah satu planet di peta lintasan untuk menampilkan rincian ringkas, ukuran relatif, serta karakteristik menarik planet tersebut secara detail.</p>
          </div>
        </div>

        <div class="flex justify-end gap-3">
          <button onclick="goToSlide(0)" class="px-5 py-2.5 bg-slate-800 text-slate-300 hover:bg-slate-700 transition rounded-xl font-bold text-sm">Kembali</button>
          <button onclick="goToSlide(2)" class="px-5 py-2.5 bg-indigo-600 text-white hover:bg-indigo-500 transition rounded-xl font-bold text-sm flex items-center gap-1">Lanjut: Video Belajar <i data-lucide="arrow-right" class="w-4 h-4"></i></button>
        </div>
      </section>

      <!-- Slide 2: Video Pembelajaran (NEW EMBED SLIDE) -->
      <section id="slide-2" class="slide-pane hidden max-w-4xl mx-auto space-y-6">
        <div class="text-center space-y-2">
          <span class="bg-indigo-500/10 border border-indigo-500/30 text-indigo-300 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider">Materi Visual</span>
          <h2 class="font-title text-3xl font-black text-white">Video Pembelajaran Tata Surya</h2>
          <p class="text-slate-400">Tonton video seru di bawah ini untuk memahami materi Tata Surya dengan lebih asyik!</p>
        </div>

        <!-- Video Frame Container -->
        <div class="bg-slate-900/60 p-4 md:p-6 rounded-3xl border border-slate-800 space-y-4">
          <div class="relative w-full aspect-video rounded-2xl overflow-hidden bg-slate-950 border border-slate-800 shadow-2xl">
            <!-- Embed YouTube Video -->
            <iframe 
              class="absolute inset-0 w-full h-full" 
              src="https://www.youtube.com/embed/wAr5DARC6rc" 
              title="Video Pembelajaran Sistem Tata Surya Kelas 5 SD" 
              frameborder="0" 
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
              allowfullscreen>
            </iframe>
          </div>
          
          <div class="bg-indigo-950/20 p-4 rounded-xl border border-indigo-500/10 flex items-start gap-3">
            <span class="text-2xl mt-0.5">💡</span>
            <div>
              <h4 class="font-bold text-slate-200 text-sm">Catatan Kapten Cilik:</h4>
              <p class="text-slate-400 text-xs mt-1 leading-relaxed">
                Perhatikan baik-baik susunan planet, perbedaan karakteristik planet dalam dan planet luar, serta bagaimana benda-benda angkasa tersebut bergerak mengitari matahari! Informasi di video ini akan sangat membantumu menjawab game pencocokan kata berikutnya.
              </p>
            </div>
          </div>
        </div>

        <div class="flex justify-between">
          <button onclick="goToSlide(1)" class="px-5 py-2.5 bg-slate-800 text-slate-300 hover:bg-slate-700 transition rounded-xl font-bold text-sm">Kembali</button>
          <button onclick="goToSlide(3)" class="px-5 py-2.5 bg-indigo-600 text-white hover:bg-indigo-500 transition rounded-xl font-bold text-sm flex items-center gap-1">Lanjut: Kamus Planet <i data-lucide="arrow-right" class="w-4 h-4"></i></button>
        </div>
      </section>

      <!-- Slide 3: Kamus Planet (Encyclopedia) -->
      <section id="slide-3" class="slide-pane hidden max-w-4xl mx-auto space-y-6">
        <div class="text-center space-y-2">
          <h2 class="font-title text-3xl font-black text-white">Kamus Lengkap Planet</h2>
          <p class="text-slate-400">Pelajari seluruh karakteristik planet di bawah ini untuk bekal bermain game selanjutnya!</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-h-[50vh] overflow-y-auto pr-2" id="planet-encyclopedia">
          <!-- Dinamis di-render lewat JavaScript -->
        </div>

        <div class="flex justify-between">
          <button onclick="goToSlide(2)" class="px-5 py-2.5 bg-slate-800 text-slate-300 hover:bg-slate-700 transition rounded-xl font-bold text-sm">Kembali</button>
          <button onclick="goToSlide(4)" class="px-5 py-2.5 bg-indigo-600 text-white hover:bg-indigo-500 transition rounded-xl font-bold text-sm flex items-center gap-1">Ayo Main: Pasangkan Planet <i data-lucide="arrow-right" class="w-4 h-4"></i></button>
        </div>
      </section>

      <!-- Slide 4: Game Drag and Drop (Pasangkan Planet) -->
      <section id="slide-4" class="slide-pane hidden max-w-4xl mx-auto space-y-6">
        <div class="text-center space-y-2">
          <span class="bg-amber-500/10 border border-amber-500/30 text-amber-300 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider">Misi Game #1</span>
          <h2 class="font-title text-3xl font-black text-white">Pasangkan Rahasia Planet!</h2>
          <p class="text-slate-400">
            Seret kotak planet ke kotak ciri-ciri planet yang cocok! 
            <span class="text-yellow-400 font-semibold block sm:inline mt-1 sm:mt-0">💡 Bisa juga dengan cara ketuk planetnya lalu ketuk kotak jawabannya!</span>
          </p>
        </div>

        <!-- Arena Permainan -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 bg-slate-900/60 p-6 rounded-3xl border border-slate-800">
          
          <!-- Sumber Tarik (Draggables) -->
          <div class="space-y-4">
            <h3 class="font-title text-lg font-bold text-indigo-300 border-b border-indigo-500/20 pb-2">Pilihan Planet</h3>
            <div id="drag-items-container" class="grid grid-cols-2 lg:grid-cols-1 gap-3">
              <!-- Item Planet yang dapat ditarik -->
            </div>
          </div>

          <!-- Wadah Drop (Dropzones) -->
          <div class="lg:col-span-2 space-y-4">
            <h3 class="font-title text-lg font-bold text-emerald-300 border-b border-emerald-500/20 pb-2">Karakteristik / Deskripsi Planet</h3>
            <div id="drop-zones-container" class="space-y-3">
              <!-- Slot Pencocokan -->
            </div>
          </div>
        </div>

        <div class="flex justify-between items-center">
          <button onclick="goToSlide(3)" class="px-5 py-2.5 bg-slate-800 text-slate-300 hover:bg-slate-700 transition rounded-xl font-bold text-sm">Kembali</button>
          
