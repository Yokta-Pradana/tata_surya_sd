    // --- SLIDE 4 (shifted): GAME DRAG AND DROP (DENGAN 4 PILIHAN ACAK DARI 8 PLANET) ---
    function buildDragDropGame() {
      const itemsContainer = document.getElementById('drag-items-container');
      const zonesContainer = document.getElementById('drop-zones-container');
      
      itemsContainer.innerHTML = "";
      zonesContainer.innerHTML = "";

      // Acak dan ambil 4 pasang planet dari total 8 planet untuk game ini
      currentDragDropPairs = [...allDragDropPairs]
        .sort(() => Math.random() - 0.5)
        .slice(0, 4);

      // Render Draggable items (Pilihan Jawaban)
      // Acak urutan tampilannya agar bervariasi
      const randomizedItems = [...currentDragDropPairs].sort(() => Math.random() - 0.5);
      randomizedItems.forEach(item => {
        const div = document.createElement('div');
        div.className = "drag-item cursor-grab bg-indigo-950/40 hover:bg-indigo-900/50 border border-indigo-500/30 p-4 rounded-xl font-bold text-center text-indigo-200 transition select-none flex items-center justify-center gap-2 touch-none active:cursor-grabbing";
        div.id = `dd-item-${item.id}`;
        div.dataset.item = item.id;
        div.dataset.name = item.name;
        div.innerHTML = `<i data-lucide="grip-vertical" class="w-4 h-4 opacity-50"></i> <span>${item.name}</span>`;
        itemsContainer.appendChild(div);
      });

      // Render Dropzones (Karakteristik Deskripsi)
      const randomizedZones = [...currentDragDropPairs].sort(() => Math.random() - 0.5);
      randomizedZones.forEach(zone => {
        const div = document.createElement('div');
        div.className = "drop-zone border-2 border-dashed border-slate-700 bg-slate-950/20 p-4 rounded-xl flex items-center justify-between gap-4 transition duration-300 min-h-[70px]";
        div.dataset.answer = zone.id;
        
        div.innerHTML = `
          <p class="text-sm text-slate-300 font-semibold flex-1">${zone.clue}</p>
          <div class="drop-target-area w-32 md:w-40 h-10 border border-slate-700 bg-slate-900/60 rounded-lg flex items-center justify-center text-xs text-slate-500 italic px-2 text-center">
            Letakkan di sini
          </div>
        `;
        zonesContainer.appendChild(div);
      });

      lucide.createIcons();
      setupDragDropListeners();
    }

    function setupDragDropListeners() {
      const draggables = document.querySelectorAll('.drag-item');
      const zones = document.querySelectorAll('.drop-zone');

      let activeDrag = null;
      let startX = 0, startY = 0;

      draggables.forEach(el => {
        // EVENT UNTUK LAYAR SENTUH & MOUSE (POINTER EVENTS)
        el.addEventListener('pointerdown', (e) => {
          if (el.classList.contains('matched')) return;
          activeDrag = el;
          el.style.touchAction = 'none'; // Cegah scrolling bawaan HP saat digeser
          el.style.zIndex = '100';
          el.style.transition = 'none';
          
          startX = e.clientX;
          startY = e.clientY;
          el.setPointerCapture(e.pointerId);

          // Hilangkan highlight tap penonton sebelumnya jika ada
          if (selectedDragSource && selectedDragSource !== el) {
            selectedDragSource.classList.remove('ring-4', 'ring-amber-400');
          }
          selectedDragSource = el;
          el.classList.add('ring-4', 'ring-amber-400');
          playTone(400, 'sine', 0.05);
        });

        el.addEventListener('pointermove', (e) => {
          if (activeDrag !== el) return;
          const dx = e.clientX - startX;
          const dy = e.clientY - startY;
          // Gunakan translate3d untuk akselerasi perangkat keras
          el.style.transform = `translate3d(${dx}px, ${dy}px, 0)`;
        });

        el.addEventListener('pointerup', (e) => {
          if (activeDrag !== el) return;
          activeDrag = null;
          el.releasePointerCapture(e.pointerId);
          el.style.zIndex = '';
          el.style.transition = 'all 0.2s ease';

          // Mendapatkan lokasi jatuhnya pointer
          const cx = e.clientX;
          const cy = e.clientY;

          let matched = false;

          zones.forEach(zone => {
            const zoneRect = zone.getBoundingClientRect();
            // Cek collision antara koordinat pointer dengan area dropzone
            if (cx >= zoneRect.left && cx <= zoneRect.right &&
                cy >= zoneRect.top && cy <= zoneRect.bottom) {
              
              if (zone.dataset.answer === el.dataset.item && !zone.classList.contains('filled')) {
                matched = true;
                handleDragDropMatch(el, zone);
              }
            }
          });

          if (!matched) {
            // Kembali ke tempat semula jika salah posisi
            el.style.transform = 'translate3d(0, 0, 0)';
            playTone(180, 'sawtooth', 0.15);
          }
        });
      });

      // Fitur Tap-To-Match Fallback (Sangat membantu siswa di HP)
      zones.forEach(zone => {
        zone.addEventListener('click', () => {
          if (zone.classList.contains('filled')) return;
          
          if (selectedDragSource) {
            if (zone.dataset.answer === selectedDragSource.dataset.item) {
              handleDragDropMatch(selectedDragSource, zone);
              selectedDragSource = null;
            } else {
              // Animasi Gagal / Salah pasang
              selectedDragSource.classList.add('animate-shake');
              playTone(180, 'sawtooth', 0.2);
              setTimeout(() => {
                selectedDragSource.classList.remove('animate-shake');
              }, 300);
            }
          }
        });
      });
    }

    function handleDragDropMatch(sourceEl, zoneEl) {
      // Tandai dropzone sudah terisi
      zoneEl.classList.remove('border-slate-700', 'bg-slate-950/20');
      zoneEl.classList.add('filled', 'bg-emerald-950/30', 'border-emerald-500/50');
      
      const targetArea = zoneEl.querySelector('.drop-target-area');
      targetArea.className = "w-32 md:w-40 h-10 bg-emerald-500/20 border border-emerald-400 text-emerald-300 font-bold rounded-lg flex items-center justify-center text-xs gap-1";
      targetArea.innerHTML = `<i data-lucide="check" class="w-4 h-4"></i> ${sourceEl.dataset.name}`;
      
      // Matikan draggable pada item asli
      sourceEl.classList.add('matched', 'opacity-30', 'pointer-events-none');
      sourceEl.classList.remove('ring-4', 'ring-amber-400');
      sourceEl.style.transform = 'translate3d(0,0,0)';

      // Nada sukses pasang
      playTone(523, 'sine', 0.1);
      setTimeout(() => playTone(659, 'sine', 0.15), 100);

      lucide.createIcons();
      checkDragDropProgress();
    }

    function checkDragDropProgress() {
      const totalRequired = currentDragDropPairs.length;
      const currentFilled = document.querySelectorAll('.drop-zone.filled').length;

      if (currentFilled === totalRequired && !dragDropDone) {
        dragDropDone = true;
        totalScore += 50;
        updateScoreUI();
        
        const successBox = document.getElementById('dragdrop-success');
        successBox.classList.remove('hidden');
        
        // Efek nada pesta luar angkasa
        setTimeout(() => playTone(523, 'sine', 0.1), 100);
        setTimeout(() => playTone(659, 'sine', 0.1), 200);
        setTimeout(() => playTone(784, 'sine', 0.1), 300);
        setTimeout(() => playTone(1046, 'sine', 0.3), 400);
      }
    }

    // --- SLIDE 5 (shifted): GAME DRAG THE WORD (LENGKAPI KALIMAT) ---
    function buildDragWordGame() {
      const bankContainer = document.getElementById('word-bank-container');
      const sentencesContainer = document.getElementById('sentences-container');

      bankContainer.innerHTML = "";
      sentencesContainer.innerHTML = "";

      // List kata-kata kunci pilihan jawaban
      const words = ["Matahari", "Rotasi", "Revolusi", "Bulan"];
      // Acak kata pilihan
      const randomizedWords = [...words].sort(() => Math.random() - 0.5);

      randomizedWords.forEach(word => {
        const div = document.createElement('div');
        div.className = "drag-word cursor-grab bg-purple-950/40 hover:bg-purple-900/50 border border-purple-500/30 px-4 py-2.5 rounded-full font-bold text-sm text-purple-200 transition select-none flex items-center gap-1.5 touch-none active:cursor-grabbing";
        div.id = `dw-word-${word.toLowerCase()}`;
        div.dataset.word = word;
        div.innerHTML = `<i data-lucide="plus-circle" class="w-4 h-4 opacity-50"></i> <span>${word}</span>`;
        bankContainer.appendChild(div);
      });

      // Render Kalimat Rumpang
      dragWordSentences.forEach((s, idx) => {
        const div = document.createElement('div');
        div.className = "flex flex-col md:flex-row items-start md:items-center gap-2 p-4 bg-slate-950/40 rounded-2xl border border-slate-800/60";
        
        // Merakit teks kalimat rumpang dengan mengganti [target] jadi div dropzone
        const formattedText = s.text.replace("[target]", `
          <div class="word-dropzone inline-flex w-32 h-8 mx-2 border-2 border-dashed border-slate-700 bg-slate-900/60 rounded-md align-middle items-center justify-center text-xs text-slate-500 font-bold italic transition" data-answer="${s.answer}">
            Sini
          </div>
        `);

        div.innerHTML = `
          <span class="w-6 h-6 rounded-full bg-purple-600/20 text-purple-300 border border-purple-500/30 flex items-center justify-center text-xs font-extrabold">${idx+1}</span>
          <div class="flex-1 text-sm md:text-base leading-relaxed text-slate-200">
            ${formattedText}
          </div>
        `;
        sentencesContainer.appendChild(div);
      });

      lucide.createIcons();
      setupDragWordListeners();
    }

    function setupDragWordListeners() {
      const words = document.querySelectorAll('.drag-word');
      const dropzones = document.querySelectorAll('.word-dropzone');

      let activeWordDrag = null;
      let startX = 0, startY = 0;

      words.forEach(el => {
        el.addEventListener('pointerdown', (e) => {
          if (el.classList.contains('matched')) return;
          activeWordDrag = el;
          el.style.touchAction = 'none';
          el.style.zIndex = '100';
          el.style.transition = 'none';
          
          startX = e.clientX;
          startY = e.clientY;
          el.setPointerCapture(e.pointerId);

          if (selectedWordSource && selectedWordSource !== el) {
            selectedWordSource.classList.remove('ring-4', 'ring-purple-400');
          }
          selectedWordSource = el;
          el.classList.add('ring-4', 'ring-purple-400');
          playTone(420, 'sine', 0.05);
        });

        el.addEventListener('pointermove', (e) => {
          if (activeWordDrag !== el) return;
          const dx = e.clientX - startX;
          const dy = e.clientY - startY;
          el.style.transform = `translate3d(${dx}px, ${dy}px, 0)`;
        });

        el.addEventListener('pointerup', (e) => {
          if (activeWordDrag !== el) return;
          activeWordDrag = null;
          el.releasePointerCapture(e.pointerId);
          el.style.zIndex = '';
          el.style.transition = 'all 0.2s ease';

          const cx = e.clientX;
          const cy = e.clientY;

          let matched = false;

          dropzones.forEach(zone => {
            const zoneRect = zone.getBoundingClientRect();
            if (cx >= zoneRect.left && cx <= zoneRect.right &&
                cy >= zoneRect.top && cy <= zoneRect.bottom) {
              
              if (zone.dataset.answer.toLowerCase() === el.dataset.word.toLowerCase() && !zone.classList.contains('filled')) {
                matched = true;
                handleWordMatch(el, zone);
              }
            }
          });

          if (!matched) {
            el.style.transform = 'translate3d(0, 0, 0)';
            playTone(180, 'sawtooth', 0.15);
          }
        });
      });

      // Tap fallback untuk Game Word Drop
      dropzones.forEach(zone => {
        zone.addEventListener('click', () => {
          if (zone.classList.contains('filled')) return;

          if (selectedWordSource) {
            if (zone.dataset.answer.toLowerCase() === selectedWordSource.dataset.word.toLowerCase()) {
              handleWordMatch(selectedWordSource, zone);
              selectedWordSource = null;
            } else {
              selectedWordSource.classList.add('animate-shake');
              playTone(180, 'sawtooth', 0.2);
              setTimeout(() => {
                selectedWordSource.classList.remove('animate-shake');
              }, 300);
            }
          }
        });
      });
    }

    function handleWordMatch(sourceEl, zoneEl) {
      zoneEl.classList.remove('border-slate-700', 'bg-slate-900/60', 'text-slate-500', 'italic');
      zoneEl.classList.add('filled', 'bg-purple-500/20', 'border-purple-400', 'text-purple-300');
      zoneEl.innerHTML = `<span class="flex items-center gap-1"><i data-lucide="check" class="w-3.5 h-3.5"></i> ${sourceEl.dataset.word}</span>`;

      sourceEl.classList.add('matched', 'opacity-30', 'pointer-events-none');
      sourceEl.classList.remove('ring-4', 'ring-purple-400');
      sourceEl.style.transform = 'translate3d(0,0,0)';

      playTone(587, 'sine', 0.1);
      setTimeout(() => playTone(739, 'sine', 0.15), 100);

      lucide.createIcons();
      checkDragWordProgress();
    }

    function checkDragWordProgress() {
      const totalRequired = dragWordSentences.length;
      const currentFilled = document.querySelectorAll('.word-dropzone.filled').length;

      if (currentFilled === totalRequired && !dragWordDone) {
        dragWordDone = true;
        totalScore += 50;
        updateScoreUI();

        const successBox = document.getElementById('dragword-success');
        successBox.classList.remove('hidden');

        setTimeout(() => playTone(587, 'sine', 0.1), 100);
        setTimeout(() => playTone(739, 'sine', 0.1), 200);
        setTimeout(() => playTone(880, 'sine', 0.1), 300);
        setTimeout(() => playTone(1174, 'sine', 0.3), 400);
      }
    }


    // --- SLIDE 6 (shifted): KUIS PILIHAN GANDA ---
    function loadQuizQuestion() {
      const q = quizData[currentQuizIndex];
      
      // Update nomor pertanyaan
      document.getElementById('quiz-current-num').innerText = currentQuizIndex + 1;
      document.getElementById('quiz-question-text').innerText = q.question;

      // Update progress bar
      const pct = ((currentQuizIndex + 1) / quizData.length) * 100;
      document.getElementById('quiz-progress-bar').style.width = `${pct}%`;

      // Render Pilihan Jawaban
      const optionsContainer = document.getElementById('quiz-options-container');
      optionsContainer.innerHTML = "";

      q.options.forEach((opt, idx) => {
        const btn = document.createElement('button');
        btn.className = "quiz-opt-btn text-left p-4 bg-slate-950/40 hover:bg-slate-800/60 border border-slate-800 hover:border-indigo-500/30 rounded-2xl font-semibold text-slate-200 transition duration-300 flex items-center gap-3";
        btn.onclick = () => selectQuizAnswer(idx);
        
        btn.innerHTML = `
          <span class="w-8 h-8 rounded-xl bg-slate-800 flex items-center justify-center text-xs text-indigo-400 font-bold border border-slate-700 uppercase">${String.fromCharCode(65 + idx)}</span>
          <span class="flex-1 text-sm md:text-base">${opt}</span>
        `;
        optionsContainer.appendChild(btn);
      });

      // Sembunyikan tombol next dan feedback
      const nextBtn = document.getElementById('quiz-next-btn');
      nextBtn.disabled = true;
      nextBtn.innerHTML = `<span>Misi Berikutnya</span> <i data-lucide="chevron-right" class="w-4 h-4"></i>`;

      const fb = document.getElementById('quiz-feedback');
      fb.className = "hidden p-4 rounded-2xl border text-sm font-bold transition-all duration-300";
      fb.innerHTML = "";

      lucide.createIcons();
    }

    function selectQuizAnswer(selectedIndex) {
      const q = quizData[currentQuizIndex];
      const nextBtn = document.getElementById('quiz-next-btn');
      const feedback = document.getElementById('quiz-feedback');
      
      // Kunci semua tombol kuis agar tidak bisa ganti jawaban
      document.querySelectorAll('.quiz-opt-btn').forEach(btn => {
        btn.disabled = true;
        btn.classList.add('opacity-60');
      });

      const options = document.querySelectorAll('.quiz-opt-btn');

      if (selectedIndex === q.answer) {
        // Jawaban Benar
        options[selectedIndex].classList.add('border-emerald-500', 'bg-emerald-950/20');
        options[selectedIndex].classList.remove('opacity-60');
        
        feedback.className = "p-4 rounded-2xl border border-emerald-500/30 bg-emerald-500/10 text-emerald-300 flex flex-col gap-1";
        feedback.innerHTML = `<span class="flex items-center gap-1.5"><i data-lucide="check-circle" class="w-4 h-4"></i> Jawaban Benar! (+10 Poin)</span> <p class="text-xs font-normal text-slate-300">${q.feedback}</p>`;
        
        quizScore++;
        totalScore += 10;
        updateScoreUI();

        // Sound sukses kuis
        playTone(523, 'sine', 0.1);
        setTimeout(() => playTone(659, 'sine', 0.1), 100);
        setTimeout(() => playTone(784, 'sine', 0.2), 200);
      } else {
        // Jawaban Salah
        options[selectedIndex].classList.add('border-rose-500', 'bg-rose-950/20');
        options[selectedIndex].classList.remove('opacity-60');
        
        // Tunjukkan jawaban yang benar
        options[q.answer].classList.add('border-emerald-500', 'bg-emerald-950/10');
        options[q.answer].classList.remove('opacity-60');

        feedback.className = "p-4 rounded-2xl border border-rose-500/30 bg-rose-500/10 text-rose-300 flex flex-col gap-1";
        feedback.innerHTML = `<span class="flex items-center gap-1.5"><i data-lucide="alert-circle" class="w-4 h-4"></i> Kurang Tepat!</span> <p class="text-xs font-normal text-slate-300">${q.feedback}</p>`;

        playTone(150, 'sawtooth', 0.3);
      }

      document.getElementById('quiz-correct-count').innerText = `BENAR: ${quizScore}`;
      feedback.classList.remove('hidden');
      nextBtn.disabled = false;

      // Ubah tombol jadi "Selesaikan Kuis" jika pertanyaan terakhir
      if (currentQuizIndex === quizData.length - 1) {
        nextBtn.innerHTML = `<span>Terima Sertifikat</span> <i data-lucide="award" class="w-4 h-4"></i>`;
      }
      lucide.createIcons();
    }

    function nextQuiz() {
      if (currentQuizIndex < quizData.length - 1) {
        currentQuizIndex++;
        loadQuizQuestion();
      } else {
        // Game selesai, pergi ke Sertifikat (Slide 7)
        renderCertificate();
        goToSlide(7);
      }
    }

    // --- SLIDE 7 (shifted): SERTIFIKAT KELULUSAN ---
    function renderCertificate() {
      // Set Grade
      const gradeText = document.getElementById('cert-grade');
      if (quizScore === 5) {
        gradeText.innerText = "A+ Kosmonot Sempurna";
        gradeText.className = "text-xl font-extrabold text-amber-400";
      } else if (quizScore >= 3) {
        gradeText.innerText = "A Cukup Handal";
        gradeText.className = "text-xl font-extrabold text-emerald-400";
      } else {
        gradeText.innerText = "B Penjelajah Hebat";
        gradeText.className = "text-xl font-extrabold text-sky-400";
      }

      // Kembang Api Nada
      playTone(523, 'sine', 0.1);
      setTimeout(() => playTone(659, 'sine', 0.1), 150);
      setTimeout(() => playTone(784, 'sine', 0.15), 300);
      setTimeout(() => playTone(987, 'sine', 0.2), 450);
      setTimeout(() => playTone(1174, 'sine', 0.35), 600);
    }

    function restartAll() {
      currentQuizIndex = 0;
      quizScore = 0;
      totalScore = 0;
      dragDropDone = false;
      dragWordDone = false;

      buildDragDropGame();
      buildDragWordGame();
      loadQuizQuestion();
      updateScoreUI();

      document.getElementById('dragdrop-success').classList.add('hidden');
      document.getElementById('dragword-success').classList.add('hidden');
      document.getElementById('quiz-correct-count').innerText = `BENAR: 0`;

      goToSlide(0);
    }
  </script>
